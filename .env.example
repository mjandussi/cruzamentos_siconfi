# O aplicativo é público por padrão. Use true para exigir login.
AUTH_ENABLED=false

# Política de sessão e bloqueio (minutos/tentativas).
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=60

# Preencha somente com hashes bcrypt; nunca use senhas em texto puro.
USER_MJANDUSSI=
USER_BELEM=
USER_SUBCONT=
